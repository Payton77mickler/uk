{
  "name": "kiln-launcher",
  "version": "0.2.0",
  "description": "Kiln: a Minecraft launcher with instances, a mod browser and client modules",
  "author": "Kiln",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kiln.launcher",
    "productName": "Kiln",
    "files": ["**/*", "!resources/**", "!dist/**"],
    "extraResources": [{ "from": "resources", "to": "resources" }],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "icon": "build/icon.png" },
    "linux": { "icon": "build/icon.png", "target": "AppImage" }
  }
}
